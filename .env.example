# Neon pooled URL for application/serverless traffic
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Neon direct URL for schema migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
PG_POOL_MAX=5

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Long random value required by the Vercel demo API
DEMO_API_KEY=

# Optional news enrichment
NEWSAPI_KEY=
