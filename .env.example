# Neon pooled connection string for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Neon direct (unpooled) connection string for schema migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional: disable TLS only for a local PostgreSQL instance.
# DATABASE_SSL=disable
PG_POOL_MAX=5

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEWSAPI_KEY=
